{
    "//": "cleanUrls + trailingSlash keep exactly ONE spelling of each URL live: /docs, never /docs/ or /docs/index.html. Any second spelling that answers 200 is a duplicate of a page we are trying to get indexed. Vercel checks the filesystem before applying `rewrites`, so the prerendered dist/docs/index.html wins over the SPA catch-all below.",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/api/cauldron/creature/:rarity/:id", "destination": "/api/cauldron/creature?rarity=:rarity&id=:id" },
      { "source": "/api/cauldron/liquidatoor/:id", "destination": "/api/cauldron/liquidatoor?id=:id" },
      { "source": "/api/(.*)", "destination": "/api/$1" },
      { "source": "/((?!api/)(?!(?:cauldrons|mi-frens|token|docs)(?:/|$)).*)", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/assets/(.*)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/(.*)\\.(svg|png|jpg|jpeg|gif|webp|avif|ico|woff|woff2|ttf|otf|mp4|webm|json|txt|xml)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/((?!assets/)(?!.*\\.(?:svg|png|jpg|jpeg|gif|webp|avif|ico|woff|woff2|ttf|otf|mp4|webm|json|txt|xml)$).*)",
        "headers" : [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          },
          {
            "key" : "X-Content-Type-Options",
            "value" : "nosniff"
          },
          {
            "key" : "X-Frame-Options",
            "value" : "DENY"
          },
          {
            "key" : "X-XSS-Protection",
            "value" : "1; mode=block"
          },
          {
            "key" : "Content-Security-Policy",
            "value" : "frame-ancestors 'none'"
          },
          {
            "key" : "Referrer-Policy",
            "value" : "no-referrer"
          },
          {
            "key" : "Permissions-Policy",
            "value" : "geolocation=(), microphone=()"
          }
        ]
      }
    ]
}
