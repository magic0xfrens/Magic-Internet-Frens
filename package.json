    "@vercel/node": "^5.6.18",
    "@vitejs/plugin-react": "^4.3.0",
    "cypress": "^12.7.0",
    "eslint": "^8.57.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.4",
    "puppeteer": "^24.40.0",
    "rollup-plugin-polyfill-node": "^0.12.0",
    "sass": "^1.60.0",
    "start-server-and-test": "^2.0.0",
    "typescript": "~5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vitest": "^1.6.0"
  }
