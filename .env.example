# Magic Internet Frens — environment template
#
# Copy to `.env.local` (gitignored) and fill in what you need.
#
# EVERY value here is optional for a read-only local run: contract addresses come
# from the committed manifest at indexer/deployments/round.json, and the frontend
# falls back to that manifest's public indexer URL. You only need these to point
# somewhere else, to raise rate limits, or to broadcast transactions.

# ── Frontend (Vite) ─────────────────────────────────────────────────────────

# Manifest SLOT selector, used only when VITE_CHAIN_ID is unset: "arc" picks
# round.arc.json, anything else (testnet|sepolia|primary|target|mainnet) picks
# round.json. Unrecognised values throw rather than silently landing on Sepolia.
VITE_NETWORK=testnet

# Indexer base URL: MANIFEST ONLY. There is deliberately no env override — see
# src/config/cauldron.ts, which reads `round.indexerUrl` and says so. The old
# VITE_CAULDRON_INDEXER entry here was dead: setting it did nothing at all.
# Change indexer/deployments/round.json to change the indexer.

# Sepolia RPC. Public nodes rate-limit HARD under a polling dApp, so a dedicated
# endpoint (a free Alchemy/Infura key) is strongly recommended. Accepts a
# COMMA-SEPARATED list; viem rolls over to the next on a 429, so rotating a few
# free keys multiplies the effective limit.
VITE_SEPOLIA_RPC_URL=

# WalletConnect Cloud project id. Without it only injected wallets are offered —
# the app still works, it does not crash.
VITE_WALLETCONNECT_PROJECT_ID=

# ── TARGET CHAIN ────────────────────────────────────────────────────────────
# The deployment target, defined entirely here — the app hardcodes no chain.
# Any EVM chain with EIP-1153 transient storage (Uniswap v4 needs it) and a
# CREATE2 factory (the hook's permissions live in its mined ADDRESS) will run
# the stack unmodified.
#
# VITE_CHAIN_ID IS AUTHORITATIVE and must name a chain one of the bundled
# manifests declares (its `chainId` field IS the key: round.json = the primary
# slot the cutover repoints, round.arc.json = the secondary). A VITE_CHAIN_ID no
# manifest declares is a START FAILURE, not a fallback — the app refuses rather
# than loading another chain's addresses under the wrong key and force-switching
# the wallet there before signing. Robinhood mainnet is 4663, its testnet 46630
# (46646 is not a chain id at all).
#
# Blank = the chain the selected manifest itself pins. The other VITE_CHAIN_*
# values below default per known chain id (Sepolia/Arc/4663/46630); for a chain
# with no built-in defaults, VITE_RPC_URL is REQUIRED and the build throws.
VITE_CHAIN_ID=
VITE_CHAIN_NAME=
VITE_RPC_URL=
VITE_EXPLORER_URL=
VITE_EXPLORER_NAME=
# Set to "false" only if the target is a real mainnet — it drives the
# "testnet funds have no value" caveats in the UI copy.
VITE_CHAIN_IS_TESTNET=
# NATIVE GAS TOKEN. Do NOT assume 18-decimal ETH: Arc's gas token is
# USD-denominated. A wrong `DECIMALS` does not throw, it silently shifts every
# balance the UI formats by orders of magnitude.
VITE_CHAIN_CURRENCY=
VITE_CHAIN_CURRENCY_NAME=
VITE_CHAIN_DECIMALS=

# ── Indexer (Ponder) ────────────────────────────────────────────────────────

# Postgres connection. Unset = in-memory SQLite, which is fine for local dev.
DATABASE_URL=

# Sync RPC endpoints, comma-separated; ORDERED failover (the first is primary),
# never round-robin. Unset falls back to a default chosen BY THE MANIFEST'S
# chainId; a chainId with no built-in default is a startup failure rather than a
# silent Sepolia. Robinhood 4663 -> https://rpc.mainnet.chain.robinhood.com
#
# WARNING: do NOT use a free Alchemy key here. Its eth_getLogs is capped at a
# 10-block range while Ponder syncs in much larger chunks, so every request
# errors and the process crash-loops. publicnode has no such cap.
PONDER_RPC_URL=

# Dedicated pool for the API's own chain reads, kept separate from the sync pool
# so a backfill cannot starve them. Defaults are now KEYED BY THE MANIFEST'S
# chainId — /freshness reads through this client, so a Sepolia default under a
# chain-4663 manifest made the divergence check compare Sepolia to Sepolia and
# report healthy. An unknown chain with this unset is a startup failure.
API_RPC_URL=

# ── Contracts (Foundry) ─────────────────────────────────────────────────────

# Deployer key. Scripts read this via vm.envUint — never commit a real value.
PRIVATE_KEY=

SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Fork-only suites (system invariants) skip themselves unless this is set.
# Point it at an archive-capable endpoint to run them:
#   FORK_RPC=$SEPOLIA_RPC_URL FOUNDRY_PROFILE=cauldron forge test
FORK_RPC=
FORK_BLOCK=

# ── Serverless API routes ───────────────────────────────────────────────────

# The docs assistant. Without a key it falls back to built-in answers.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Gates the correction-submission endpoint.
FREN_ADMIN_SECRET=

# /api/brand write path. Comma-separated addresses allowed to sign a branding
# update (EIP-191). UNSET = the write path is disabled entirely (fails closed).
BRAND_SIGNERS=
# Comma-separated origins allowed to POST /api/brand, e.g. https://mifrens.xyz
BRAND_ALLOWED_ORIGINS=
# Max rows /api/brand may create (default 256).
BRAND_MAX_ROWS=

# Origin /api/fren-ask fetches /llms-full.txt from. Unset = the platform
# deployment host. A request header never chooses this.
CAULDRON_DOCS_ORIGIN=

# Exact redirect URIs /api/x-token will exchange for (comma separated).
X_REDIRECT_URIS=
# Extra NFT collections /api/cauldron/liquidatoor may read (comma separated).
LIQUIDATOOR_COLLECTIONS=
