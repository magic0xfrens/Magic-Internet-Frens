# Magic Internet Frens — environment template
#
# Copy to `.env.local` (gitignored) and fill in what you need.
#
# EVERY value here is optional for a read-only local run: contract addresses come
# from the committed manifest at indexer/deployments/round.json, and the frontend
# falls back to that manifest's public indexer URL. You only need these to point
# somewhere else, to raise rate limits, or to broadcast transactions.

# ── Frontend (Vite) ─────────────────────────────────────────────────────────

# Which network the whole app targets: "testnet" (Sepolia) or "mainnet".
# One flip retargets config, wallet switching, explorer links and copy.
VITE_NETWORK=testnet

# Indexer base URL. Defaults to the public URL in the manifest, so leave unset
# unless you are running the indexer yourself. It must NOT point at this site's
# own origin — that would proxy-loop every read back into the app.
VITE_CAULDRON_INDEXER=

# Sepolia RPC. Public nodes rate-limit HARD under a polling dApp, so a dedicated
# endpoint (a free Alchemy/Infura key) is strongly recommended. Accepts a
# COMMA-SEPARATED list; viem rolls over to the next on a 429, so rotating a few
# free keys multiplies the effective limit.
VITE_SEPOLIA_RPC_URL=

# WalletConnect Cloud project id. Without it only injected wallets are offered —
# the app still works, it does not crash.
VITE_WALLETCONNECT_PROJECT_ID=

# Robinhood Chain overrides. Confirm the chainId before trusting a default:
# sources have shown 4663 for mainnet and 46646 for testnet.
VITE_ROBINHOOD_CHAIN_ID=
VITE_ROBINHOOD_RPC_URL=
VITE_ROBINHOOD_EXPLORER=

# ── Indexer (Ponder) ────────────────────────────────────────────────────────

# Postgres connection. Unset = in-memory SQLite, which is fine for local dev.
DATABASE_URL=

# Sync RPC endpoints, comma-separated; Ponder load-balances and fails over.
#
# WARNING: do NOT use a free Alchemy key here. Its eth_getLogs is capped at a
# 10-block range while Ponder syncs in much larger chunks, so every request
# errors and the process crash-loops. publicnode has no such cap.
PONDER_RPC_URL=

# Dedicated pool for the API's own chain reads, kept separate from the sync pool
# so a backfill cannot starve them.
API_RPC_URL=

# ── Contracts (Foundry) ─────────────────────────────────────────────────────

# Deployer key. Scripts read this via vm.envUint — never commit a real value.
PRIVATE_KEY=

SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Fork-only suites (system invariants) skip themselves unless this is set.
# Point it at an archive-capable endpoint to run them:
#   FORK_RPC=$SEPOLIA_RPC_URL FOUNDRY_PROFILE=cauldron forge test
FORK_RPC=
FORK_BLOCK=

# ── Serverless API routes ───────────────────────────────────────────────────

# The docs assistant. Without a key it falls back to built-in answers.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# Gates the correction-submission endpoint.
FREN_ADMIN_SECRET=
