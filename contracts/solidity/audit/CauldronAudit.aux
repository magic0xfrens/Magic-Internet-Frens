\@writefile{toc}{\contentsline {section}{\numberline {6}Findings}{10}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{C-01a --- Unbounded hook adoption mints phantom \texttt  {relaunchETH}, permanently bricking \texttt  {relaunch()}}{10}{section*.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{C-01b --- The legacy buyback spends the hook's ETH inside an attacker-chosen pool}{11}{lstnumber.-5.19}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{C-02 --- A winning proposal with an out-of-range \texttt  {nftSupply} freezes the protocol permanently}{12}{lstnumber.-8.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{H-01 --- The collection's \texttt  {deployer} is the factory, so the entire legacy-floor recycle path is unreachable}{13}{lstnumber.-11.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{H-02 --- \texttt  {CauldronSeeder} never resets \texttt  {complete}, so generation 2 onward never streams}{13}{lstnumber.-14.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{H-03 --- \texttt  {claimByBurn} burns the full amount but silently accepts a short delivery}{14}{lstnumber.-18.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{H-04 --- A trader contract that rejects ETH can freeze the perp engine on a dead generation}{15}{lstnumber.-21.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{H-05 --- The first token-side staker captures the entire previously-accrued yield pot}{16}{lstnumber.-26.15}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{M-01 --- \texttt  {setRegistryOverride} defeats the one-shot registry lock the code documents}{17}{lstnumber.-28.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{M-02 --- \texttt  {winner()} returns the live vote leader, so relaunch is front-runnable}{18}{lstnumber.-30.19}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{M-03 --- The rarity reveal offers two independent draws and the holder picks the better}{18}{lstnumber.-31.13}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{M-04 --- Crystal-ticket resolution shares the same predictable 256-block fallback}{19}{lstnumber.-33.12}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{M-05 --- \texttt  {skimInsurance} protects only \texttt  {insuranceFloor}, which defaults to zero}{19}{lstnumber.-35.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{M-06 --- Forged frens never break their dividend enchantment on transfer}{20}{lstnumber.-37.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-01 --- \texttt  {MAX\_RANGES} can halt the progressive stream mid-launch}{20}{lstnumber.-40.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-02 --- The anti-sniper surtax jitter is predictable one block ahead}{21}{lstnumber.-41.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-03 --- \texttt  {tx.origin} credit attribution mis-attributes smart-account swaps}{21}{lstnumber.-42.930}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-04 --- The tiered NFT tax reads the swap sender, not the trader}{21}{lstnumber.-43.536}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-05 --- The funding index is sized at spot, not at the manipulation-resistant mark}{21}{lstnumber.-43.536}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-06 --- A Liquidatoor badge is silently lost when no collection is wired}{22}{lstnumber.-44.427}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-07 --- \texttt  {CauldronVault.redeem} is unreachable under the unified-floor model}{22}{lstnumber.-46.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{L-08 --- \texttt  {migrateToSuccessor} leaves the seeder's liquidity behind}{22}{lstnumber.-46.9}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {7}Positive observations}{23}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8}The delivered test suite}{24}{section.8}\protected@file@percent }
