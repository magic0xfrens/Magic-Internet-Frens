\newlabel{sec:apass}{{10}{25}{Second-pass findings: lifecycle denial of service}{section.10}{}}
\@writefile{toc}{\contentsline {subsection}{A-01 --- \texttt  {CREATE2} token-address squatting permanently bricks the eternal machine}{26}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{A-01b --- A dust reserve rounds to zero liquidity and reverts the seed}{26}{lstnumber.-50.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{A-02 --- A stale \texttt  {lastTick} lets an atomic round-trip poison the liquidation mark}{27}{lstnumber.-52.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{A-03 --- The perp book can outgrow what one force-close clears, stranding the engine}{27}{lstnumber.-55.14}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{A-05 --- Recovered LP tokens can exceed \texttt  {TOTAL\_SUPPLY}, underflowing the relaunch}{28}{lstnumber.-56.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{A-04 --- Funding is not a closed transfer, so it leaks LP principal}{28}{lstnumber.-58.2}\protected@file@percent }
